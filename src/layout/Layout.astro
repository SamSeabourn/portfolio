---
import BuildStats from '../components/BuildStats.astro';
import '../styles/global.css';
import { asset } from '../utils/base-url';
const coreFontUrl = asset('DepartureMono-Regular-core.woff2');
const fullFontUrl = asset('DepartureMono-Regular-full.woff2');
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Sam Seabourn | Frontend Systems Engineer</title>
		<meta
			name="description"
			content="Frontend Systems Engineer specialising in high performance TypeScript systems for Smart TVs, browser extensions, and large scale platforms."
		/>
		<link
			rel="preload"
			href={asset('DepartureMono-Regular-core.woff2')}
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<script is:inline define:vars={{ coreFontUrl, fullFontUrl }}>
			if (sessionStorage.getItem('fonts-loaded')) {
				document.documentElement.classList.add('fonts-loaded');
			} else {
				(async () => {
					const fonts = await Promise.all([
						new FontFace('Departure Mono Core', 'url(' + coreFontUrl + ')', {
							weight: '700',
							style: 'normal',
						}).load(),
						new FontFace('Departure Mono', 'url(' + fullFontUrl + ')', {
							weight: '700',
							style: 'normal',
						}).load(),
					]);
					fonts.forEach((f) => {
						document.fonts.add(f);
					});
					document.documentElement.classList.add('fonts-loaded');
					sessionStorage.setItem('fonts-loaded', '1');
				})();
			}
		</script>

		<script>
			import { animateSvgPath } from '../helpers/animate-svg-path';
			import { mountSVG } from '../helpers/mount-svg';
			import { createFirstInteractionListener } from '../helpers/create-first-interaction-listener';
			window.createFirstInteractionListener = createFirstInteractionListener;
			window.mountSVG = mountSVG;
			window.animateSvgPath = animateSvgPath;
		</script>
		<script
			is:inline
			define:vars={{
				speculationUrls: [asset('browsersaurus/'), asset('stan/'), asset('playwright-embedded/')],
			}}
		>
			if (HTMLScriptElement.supports?.('speculationrules')) {
				const rules = document.createElement('script');
				rules.type = 'speculationrules';
				rules.textContent = JSON.stringify({ prerender: [{ urls: speculationUrls }] });
				document.head.appendChild(rules);
			}
		</script>
		<meta name="robots" content="index, follow" />
		<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#200827" media="(prefers-color-scheme: dark)" />
		<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
		<link rel="icon" type="image/svg+xml" href={asset('favicon.svg')} />
		<link rel="apple-touch-icon" href={asset('apple-touch-icon.png')} />
		<meta property="og:type" content="website" />
		<meta property="og:title" content="Sam Seabourn | Frontend Systems Engineer" />
		<meta
			property="og:description"
			content="Frontend Systems Engineer with 7+ years of experience building performance critical TypeScript systems for Smart TVs, browser extensions and large scale streaming platforms. Google contributor."
		/>
		<meta property="og:url" content={`https://samseabourn.github.io${asset('')}`} />
		<meta property="og:image" content={`https://samseabourn.github.io${asset('hero-md.png')}`} />
	</head>
	<body>
		<slot />
		{Astro.url.pathname === '/' && <BuildStats />}
	</body>
</html>
