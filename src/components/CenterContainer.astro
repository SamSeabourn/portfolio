---

---

<main class="cc">
	<div>
		<slot />
	</div>
</main>

<style>
	main {
		margin: 0 auto;
		width: 100%;
		max-width: 1920px;
		padding: 0;
		position: relative;
		box-sizing: border-box;
		box-shadow:
			-20px 0 30px -20px rgba(0, 0, 0, 0.25),
			20px 0 30px -20px rgba(0, 0, 0, 0.25);
	}

	div {
		--stripe-a: #fcfcfc;
		--stripe-b: #f5f5f5;
		color: var(--text);
		background-image: linear-gradient(
			135deg,
			var(--stripe-a) 25%,
			var(--stripe-b) 25%,
			var(--stripe-b) 50%,
			var(--stripe-a) 50%,
			var(--stripe-a) 75%,
			var(--stripe-b) 75%,
			var(--stripe-b) 100%
		);
		background-size: 28.28px 28.28px;
	}

	@media (prefers-color-scheme: dark) {
		div {
			--stripe-a: #180718;
			--stripe-b: #280e28;
		}
	}
</style>
